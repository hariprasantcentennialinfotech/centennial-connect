# ==============================================================================
# Centennial Connect — Production Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# SESSION_SECRET must be at least 32 characters long for cryptographic JWT signing
SESSION_SECRET=replace_with_a_secure_random_32_character_string_for_production
ENCRYPTION_KEY=
ENCRYPTION_IV=

# ------------------------------------------------------------------------------
# MongoDB Atlas Database
# ------------------------------------------------------------------------------
# Provide either direct MONGODB_URI or individual credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/centennial_connect?retryWrites=true&w=majority
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=centennial_connect
MONGODB_HOST=

# ------------------------------------------------------------------------------
# Telephony Provider (mock | twilio | telnyx)
# ------------------------------------------------------------------------------
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=

# ------------------------------------------------------------------------------
# AI Voice Agent Provider (mock | elevenlabs | openai | vapi)
# ------------------------------------------------------------------------------
VOICE_AI_PROVIDER=mock
VOICE_AI_API_KEY=

# ------------------------------------------------------------------------------
# Email & Transactional Dispatch (Brevo HTTP REST / SMTP)
# ------------------------------------------------------------------------------
BREVO_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS="your app password"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_EMAIL=your_email@gmail.com
MAIL_FROM_NAME="Centennial Infotech"

# ------------------------------------------------------------------------------
# Cloudinary Storage
# ------------------------------------------------------------------------------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# ------------------------------------------------------------------------------
# Google OAuth & reCAPTCHA
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RECAPTCHA_SECRET_KEY=
