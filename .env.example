# Centennial Connect SaaS — Example Environment Variables

# MongoDB Atlas Configuration
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=centennial_connect
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/centennial_connect?retryWrites=true&w=majority

# Telephony Provider (mock | twilio | telnyx)
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=

# AI Voice Agent Provider (mock | elevenlabs | openai | vapi)
VOICE_AI_PROVIDER=mock
VOICE_AI_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
